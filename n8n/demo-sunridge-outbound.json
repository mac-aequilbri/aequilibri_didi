{
  "name": "DEMO sunridge · outbound PLAT_OUTBOX → mac@aequilibri",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "c1000000-0000-4000-8000-000000000001",
      "name": "Every 2 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-240, 160]
    },
    {
      "parameters": {},
      "id": "c1000000-0000-4000-8000-000000000006",
      "name": "Manual test trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-240, -20]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://api.airtable.com/v0/app51Tmrgab3QYP4Z/PLAT_OUTBOX",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "filterByFormula",
              "value": "AND({Status}='pending',{Org_Slug}='sunridge')"
            },
            {
              "name": "pageSize",
              "value": "10"
            }
          ]
        },
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000002",
      "name": "Fetch pending outbox rows",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-20, 60]
    },
    {
      "parameters": {
        "fieldToSplitOut": "records",
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000003",
      "name": "Split out records",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [200, 60]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "mac@aequilibri.com",
        "subject": "=[aequilibri · sunridge] {{ $json.fields.Event }}",
        "emailType": "text",
        "message": "={{ $json.fields.Summary || $json.fields.Event }}\n\n—\nEvent: {{ $json.fields.Event }}\nEntity: {{ $json.fields.Entity_Type }} {{ $json.fields.Entity_Id }}\nRaised: {{ $json.fields.Created_At }}\n\nOpen the app: https://aequilibri-next.onrender.com/app/sunridge\n\nSent by the aequilibri outbound queue (PLAT_OUTBOX) via n8n.",
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000004",
      "name": "Gmail — send to mac@aequilibri",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [420, 60]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://api.airtable.com/v0/app51Tmrgab3QYP4Z/PLAT_OUTBOX/{{ $('Split out records').item.json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "airtableTokenApi",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ fields: { Status: 'delivered', Delivered_At: $now.toISO() } }) }}",
        "options": {}
      },
      "id": "c1000000-0000-4000-8000-000000000005",
      "name": "Mark delivered",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 60]
    }
  ],
  "connections": {
    "Every 2 minutes": {
      "main": [[{ "node": "Fetch pending outbox rows", "type": "main", "index": 0 }]]
    },
    "Manual test trigger": {
      "main": [[{ "node": "Fetch pending outbox rows", "type": "main", "index": 0 }]]
    },
    "Fetch pending outbox rows": {
      "main": [[{ "node": "Split out records", "type": "main", "index": 0 }]]
    },
    "Split out records": {
      "main": [[{ "node": "Gmail — send to mac@aequilibri", "type": "main", "index": 0 }]]
    },
    "Gmail — send to mac@aequilibri": {
      "main": [[{ "node": "Mark delivered", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
